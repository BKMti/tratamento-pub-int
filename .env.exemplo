# Copie para .env e preencha. O .env fica fora do git.

# API do DeepSeek (compatível com o cliente OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Banco `forum` (lago de dados do O Fórum). A extração abre a conexão SÓ LEITURA
# (default_transaction_read_only=on) e com statement_timeout.
FORUM_DATABASE_URL=postgresql://usuario:senha@host:5432/forum

# Nomes dos analistas da Controladoria cujas tarefas definem o gabarito
# (como aparecem em monitoramento.usuario.nome), separados por ";".
TRATAMENTO_CONTROLLERS=

# Tetos do contador de custo (a rodada para antes de estourar)
TETO_CHAMADAS=100
TETO_USD=0.50
